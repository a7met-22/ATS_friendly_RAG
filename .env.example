# ==========================================
# Application Environment & Observability
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ==========================================
# Security & Authentication (JWT + RBAC)
# ==========================================
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_strong_64_char_random_hex_secret
AUTH_SESSION_TTL_MINUTES=60

# JSON map of authorized users with PBKDF2 password hashes and roles ("admin" or "system_search")
AUTHORIZED_USERS_JSON={"admin@example.com":{"password_hash":"pbkdf2_sha256$...","roles":["admin"]}}

# ==========================================
# PostgreSQL 18 + pgvector Connection Pool
# ==========================================
DB_HOST=db
DB_PORT=5432
DB_NAME=resumedb
DB_USER=postgres
DB_PASSWORD=replace_with_strong_db_password
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=50

# ==========================================
# Redis (Rate Limiting, Caching & Locks)
# ==========================================
REDIS_URL=redis://redis:6379/0
SESSION_CLEANUP_INTERVAL_HOURS=6
SESSION_MAX_AGE_HOURS=24

# ==========================================
# AI Models & Document Parsing
# ==========================================
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash

PARSER_TYPE=llama
LLAMA_CLOUD_API_KEY=replace_with_your_llamacloud_api_key

# ==========================================
# Google Drive Sync & LangSmith Tracing
# ==========================================
GOOGLE_DRIVE_FOLDER_ID=replace_with_google_drive_folder_id
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-resume-assistant
